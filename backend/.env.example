# ===== 服务 =====
PORT=8080
DATA_DIR=data

# ===== PostgreSQL（默认本机端口 5432） =====
DB_URL=jdbc:postgresql://localhost:5432/momentarium
DB_USER=momentarium
DB_PASSWORD=change-me

# ===== AI（OpenCode Go） =====
# 基础地址：https://opencode.ai/inference
# 按协议追加：/openai/v1/chat/completions 或 /anthropic/v1/messages
# 默认 fake。启用 live 前请设置模型网关、模型名和密钥。
AI_MODE=fake
AI_BASE_URL=https://opencode.ai/inference/go
AI_API_KEY=
AI_TEXT_MODEL=deepseek-v4.1-flash
AI_CODE_MODEL=deepseek-v4.1-flash
AI_VISION_MODEL=deepseek-v4.1-flash
AI_REVIEW_MODEL=deepseek-v4.1-flash
AI_TEXT_PROTOCOL=openai
AI_VISION_PROTOCOL=openai
AI_USER_AGENT=Momentarium/0.1

# 单次模型调用看门狗（毫秒），默认 30 分钟；整次运行不设时限，由“停止生成”控制
AI_WATCHDOG_MS=1800000

# 场景代码生成走流式（SSE）：连续这么久（毫秒）没有收到任何数据，就按网络失败重试。
# 流式让连接上一直有数据，避免被代理/出口按“空闲”清掉；默认 300000（5 分钟）。
AI_STREAM_IDLE_MS=300000

# 所有模型调用的推理强度 reasoning_effort（low / medium / high / max）；留空 = max；off = 不发送。
AI_REASONING_EFFORT=max

# ===== 场景评审 =====
REVIEW_PASS_SCORE=3.0
SCENE_MAX_REVISIONS=2
SCENE_CODE_LIMIT_KB=1024

# ===== 地点搜索（作者主动搜索地点名称时的后端代理） =====
# 默认 fake：确定性本地实现，不访问外部服务（测试/离线演示）。
# 仅 GEOCODE_MODE=live 才会调用外部地理编码提供方；切换前确认提供方可达、使用政策与署名要求。
# 全应用合计 ≤1 次/秒（GEOCODE_MIN_INTERVAL_MS）并缓存重复查询（GEOCODE_CACHE_SIZE）。
# 只提交用户明确输入的地点名称，不携带会话令牌、照片、回忆或邀请令牌；不接受客户端自定义上游 URL。
GEOCODE_MODE=fake
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=Momentarium/0.1 (local demo; contact: none)
GEOCODE_TIMEOUT_MS=5000
GEOCODE_MIN_INTERVAL_MS=1000
GEOCODE_CACHE_SIZE=128

# ===== 共同投稿配额 =====
# 可按部署/演示需要调整，只影响服务端投稿上传（照片直传的 30 张上限不受这些键影响）。
# CONTRIBUTION_MAX_FILE_MB：单个投稿文件上限（MiB，默认 15）。
# CONTRIBUTION_MAX_BATCH：单批文件数上限（默认 10）；替换已有投稿文件时固定只允许 1 个。
# CONTRIBUTION_MAX_PHOTOS_PER_USER / CONTRIBUTION_MAX_BYTES_PER_USER：每投稿者每展览最多保留的投稿照片数（默认 20）与字节额度（默认 268435456 = 256 MiB）。
# CONTRIBUTION_MAX_PHOTOS_PER_EXHIBITION / CONTRIBUTION_MAX_BYTES_PER_EXHIBITION：每展览最多保留的投稿照片总数（默认 60）与字节额度（默认 805306368 = 768 MiB）。
# 容量计入原图、衍生图与未清理旧版本；采用后的草稿照片仍受原有 30 张上限。
CONTRIBUTION_MAX_FILE_MB=15
CONTRIBUTION_MAX_BATCH=10
CONTRIBUTION_MAX_PHOTOS_PER_USER=20
CONTRIBUTION_MAX_BYTES_PER_USER=268435456
CONTRIBUTION_MAX_PHOTOS_PER_EXHIBITION=60
CONTRIBUTION_MAX_BYTES_PER_EXHIBITION=805306368
